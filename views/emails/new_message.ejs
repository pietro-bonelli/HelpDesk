<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuovo messaggio</title>
    <!-- Font personalizzati (Google Fonts) -->
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700&family=Manrope:wght@400;600&display=swap"
        rel="stylesheet">
</head>

<body
    style="font-family: 'Manrope', Arial, sans-serif; background-color: #F6F5F1; margin: 0; padding: 40px 20px; color: #1C1B16;">

    <!-- Wrapper Principale (Limitiamo la larghezza a 600px per i client email) -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 14px; border: 1px solid #E3E1DB; overflow: hidden; border-collapse: collapse;">

        <!-- Header (Logo / Titolo) -->
        <tr>
            <td style="background-color: #2058E8; padding: 24px; text-align: center;">
                <h1
                    style="font-family: 'Syne', Arial, sans-serif; color: #ffffff; margin: 0; font-size: 24px; font-weight: 700;">
                    HelpDesk</h1>
            </td>
        </tr>

        <!-- Corpo dell'email -->
        <tr>
            <td style="padding: 32px 24px;">
                <p style="font-size: 16px; margin-top: 0; margin-bottom: 24px;">Ciao <strong>
                        <%= userName %>
                    </strong>,</p>

                <!-- Box Dettagli Ticket -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="margin-bottom: 24px; background-color: #FAFAF8; border: 1px solid #E3E1DB; border-radius: 8px;">
                    <tr>
                        <td style="padding: 16px;">
                            <p
                                style="margin: 0 0 4px 0; font-size: 13px; color: #68665D; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">
                                Ticket #<%= ticketId %>
                            </p>
                            <p
                                style="margin: 0; font-size: 16px; color: #1C1B16; font-weight: 700; font-family: 'Syne', Arial, sans-serif;">
                                <%= ticketTitle %>
                            </p>
                        </td>
                    </tr>
                </table>

                <p style="font-size: 16px; margin-top: 0; margin-bottom: 16px;"><strong>
                        <%= senderName %>
                    </strong> ha aggiunto un nuovo messaggio:</p>

                <!-- "Bolla" del messaggio in stile chat -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 32px;">
                    <tr>
                        <!-- Lasciamo un po' di spazio a destra per simulare il max-width dell'interfaccia chat -->
                        <td style="padding-right: 15%;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="background-color: #ffffff; border: 1px solid #E3E1DB; border-radius: 14px; border-bottom-left-radius: 0; box-shadow: 0 4px 12px rgba(28, 27, 22, 0.05);">
                                <tr>
                                    <td style="padding: 16px;">
                                        <!-- Testo del messaggio -->
                                        <p
                                            style="margin: 0 0 16px 0; font-size: 15px; color: #1C1B16; line-height: 1.5;">
                                            <%- messageText %>
                                        </p>

                                        <!-- Data / Nome mittente (message-data) -->
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td align="right" style="font-size: 11px;">
                                                    <span
                                                        style="font-weight: 600; color: #68665D; text-transform: uppercase;">
                                                        <%= senderName %>
                                                    </span>
                                                    &nbsp;&nbsp;
                                                    <span style="color: #9C9A90;">
                                                        <%= messageTime %>
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Bottone CTA (Call To Action) -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                        <td align="center">
                            <!-- Nota: in HTML per email i bottoni vanno fatti con i link stile block -->
                            <a href="<%= ticketUrl %>"
                                style="font-family: 'Manrope', Arial, sans-serif; display: inline-block; background-color: #2058E8; color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 10px; font-weight: 600; font-size: 16px;">Apri
                                il ticket e rispondi</a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <!-- Footer (Note a piè di pagina) -->
        <tr>
            <td style="background-color: #FAFAF8; padding: 24px; text-align: center; border-top: 1px solid #E3E1DB;">
                <p style="margin: 0; font-size: 13px; color: #9C9A90; line-height: 1.5;">
                    Hai ricevuto questa email perché sei iscritto alle notifiche di HelpDesk.<br>
                    Non rispondere direttamente a questa email.
                </p>
            </td>
        </tr>

    </table>

</body>

</html>